;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a mobility-support robot performs supply setup
;; and light-errand carrying alongside a supervising companion. Declared
;; here: the errand leg carrying the client's shopping home from the local
;; shop, and setting up supplies -- a bag of groceries lifted from the
;; robot's basket onto the kitchen counter.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-5162"
 :cases
 [{:id :errand-shopping-home
   :kind :transport
   :procedure "mobility-support robot carries the client's shopping from the local shop back to the home, at the client's walking pace"
   :params {:mass-kg 40.0 :payload-kg 10.0 :distance-m 400.0 :a-max-mps2 0.4
            :brake-decel-mps2 0.8 :drive-force-n 70.0 :crr 0.025
            :cog-height-m 0.70 :support-half-length-m 0.25 :max-time-s 1800.0}
   :sweep {:param :v-max-mps :values [0.5 0.7 0.9 1.1 1.3]}
   :quantity :cycle-time-s
   :limit {:max 420.0 :basis "estimate: a 7-minute leg so chilled items stay cold on the way home; the client's walking-pace range is also an estimate"}
   :boundary {:lo 0.3 :hi 1.5}}
  {:id :grocery-bag-to-counter
   :kind :manipulator
   :procedure "arm lifts a bag of groceries from the robot's basket onto the kitchen counter"
   :params {:l1-m 0.45 :l2-m 0.40 :m1-kg 4.0 :m2-kg 2.5 :payload-kg 4.0
            :from [0.40 -0.10] :to [0.55 0.35] :steps 500}
   :sweep {:param :duration-s :values [0.5 0.8 1.2 1.8 2.5]}
   :quantity :peak-tau1-nm
   :limit {:max 50.0 :basis "estimate: continuous shoulder torque of a ~5 kg-payload arm on a home-assistance platform"}
   :boundary {:lo 0.25 :hi 4.0}}]}
